---
import { withBase } from '../utils/url';

interface Props {
  category: string;
  count_label: string;
  title: string;
  description: string;
  button_label: string;
  href: string;
}

const { category, count_label, title, description, button_label, href } = Astro.props;
---
<div class="card-meta">
  <small>{category}</small>
  <span class="count-pill">{count_label}</span>
</div>
<strong>{title}</strong>
<span class="desc">{description}</span>
<a class="button" href={withBase(href)}>{button_label}</a>
