---
interface FunctionTile {
  num: string;
  name: string;
  role_tag?: string;
  flow_label?: string;
  question?: string;
  summary?: string;
  explanation?: string;
  scales_note?: string;
  href: string;
}

interface Props {
  tiles: FunctionTile[];
}

const { tiles } = Astro.props;
const safeJson = JSON.stringify(tiles).replace(/</g, '\\u003c');
---
<div id="nine-functions-root" class="c9-circle-wrapper">
  <div id="circle-stage" class="c9-circle-stage" role="region" aria-label="Interactive Circle of Nine">
    <canvas id="flow-canvas" aria-label="Circle of Nine — select a function to fractal in"></canvas>

    <aside id="fractal-detail-panel" class="c9-fractal-detail-panel" hidden aria-live="polite">
      <div class="c9-detail-top-bar">
        <span id="detail-tag" class="c9-detail-tag">{tiles[0].role_tag}</span>
        <button type="button" id="btn-back-circle" class="c9-btn-back">← Back to Circle of Nine</button>
      </div>

      <h3 id="detail-title" class="c9-detail-title">{tiles[0].num}. {tiles[0].name}</h3>
      <p id="detail-question" class="c9-detail-question">{tiles[0].question}</p>
      <p id="detail-summary" class="c9-detail-copy">{tiles[0].summary}</p>
      <p id="detail-explanation" class="c9-detail-copy c9-muted">{tiles[0].explanation}</p>
      <div id="detail-scales" class="c9-detail-scales">{tiles[0].scales_note}</div>
      <div id="detail-flow" class="c9-detail-flow-badge">{tiles[0].flow_label}</div>

      <div class="c9-detail-actions">
        <button type="button" id="btn-prev-fn" class="c9-btn-step">← Prev</button>
        <button type="button" id="btn-next-fn" class="c9-btn-step">Next →</button>
        <a id="detail-story-link" class="c9-btn-story" href={tiles[0].href} target="_blank" rel="noopener noreferrer">
          Open Function {tiles[0].num} Interactive Story →
        </a>
      </div>
    </aside>
  </div>

  <nav class="c9-step-strip" aria-label="Select a function on the circle">
    {tiles.map((tile, idx) => (
      <button
        type="button"
        class="c9-step-pill"
        data-fn-index={idx}
        aria-pressed="false"
      >
        <span>{tile.num}</span> {tile.name}
      </button>
    ))}
  </nav>
</div>

<style is:global>
  .c9-circle-wrapper {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    text-align: left;
  }
  .c9-circle-stage {
    position: relative;
    background: #15243a;
    border: 1px solid rgba(183, 154, 105, 0.35);
    border-top: 3px solid #b79a69;
    border-radius: 8px;
    height: clamp(500px, 68vh, 620px);
    overflow: hidden;
    box-shadow: 0 20px 44px rgba(21, 36, 58, 0.14);
  }
  .c9-circle-stage #flow-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .c9-fractal-detail-panel {
    position: absolute;
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: min(500px, 52%);
    background: #ffffff;
    border: 1px solid #e4dfd5;
    border-top: 4px solid #b79a69;
    border-radius: 6px;
    padding: clamp(20px, 2.8vw, 30px);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    text-align: left;
    box-shadow: 0 18px 40px rgba(10, 20, 34, 0.32);
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .c9-fractal-detail-panel[hidden] {
    display: none;
  }
  .c9-fractal-detail-panel.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  .c9-detail-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .c9-detail-tag {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #8d6b39;
  }
  .c9-btn-back {
    background: transparent;
    border: 1px solid #d7d3ca;
    color: #15243a;
    border-radius: 3px;
    padding: 6px 12px;
    font-size: .82rem;
    font-weight: 650;
    cursor: pointer;
  }
  .c9-btn-back:hover {
    border-color: #b79a69;
    background: #f3eee3;
  }
  .c9-detail-title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.2;
    color: #15243a;
    margin: 0 0 8px;
    max-width: none;
    text-align: left;
  }
  .c9-detail-question {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 1.06rem;
    color: #806a4a;
    margin: 0 0 14px;
    max-width: none;
    line-height: 1.4;
    text-align: left;
  }
  .c9-detail-copy {
    font-size: .96rem;
    color: #172338;
    line-height: 1.62;
    margin: 0 0 12px;
    max-width: none;
    text-align: left;
  }
  .c9-detail-copy.c9-muted {
    color: #44505e;
  }
  .c9-detail-scales {
    background: #f7f6f3;
    border-left: 3px solid #b79a69;
    padding: 10px 14px;
    font-size: .88rem;
    color: #283442;
    margin: 4px 0 14px;
    line-height: 1.5;
  }
  .c9-detail-flow-badge {
    display: inline-block;
    align-self: flex-start;
    background: #f3eee3;
    border: 1px solid #dfd3bd;
    border-radius: 999px;
    padding: 4px 12px;
    font-size: .8rem;
    font-weight: 650;
    color: #15243a;
    margin-bottom: 16px;
  }
  .c9-detail-actions {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #ebe6dc;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .c9-btn-step {
    background: #f7f6f3;
    border: 1px solid #d7d3ca;
    color: #15243a;
    border-radius: 3px;
    padding: 10px 13px;
    font-size: .86rem;
    font-weight: 650;
    cursor: pointer;
  }
  .c9-btn-step:hover {
    border-color: #b79a69;
    background: #f3eee3;
  }
  .c9-btn-story {
    flex: 1 1 auto;
    text-align: center;
    display: inline-block;
    padding: 11px 16px;
    border: 1px solid #b79a69;
    background: #b79a69;
    color: #15243a;
    text-decoration: none;
    font-weight: 650;
    font-size: .9rem;
    border-radius: 3px;
  }
  .c9-btn-story:hover,
  .c9-btn-story:focus-visible {
    background: #a58856;
    border-color: #a58856;
  }
  .c9-step-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 18px 0 0;
  }
  .c9-step-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #dfd3bd;
    color: #15243a;
    font-size: .84rem;
    font-weight: 600;
    cursor: pointer;
  }
  .c9-step-pill span {
    color: #8d6b39;
    font-weight: 700;
  }
  .c9-step-pill:hover {
    border-color: #b79a69;
    background: #f3eee3;
  }
  .c9-step-pill.is-active {
    background: #15243a;
    border-color: #15243a;
    color: #ffffff;
  }
  .c9-step-pill.is-active span {
    color: #d7bc8c;
  }

  @media (max-width: 900px) {
    .c9-circle-stage {
      height: auto;
      min-height: 460px;
      display: flex;
      flex-direction: column;
    }
    .c9-circle-stage #flow-canvas {
      height: 460px;
      flex: 0 0 auto;
    }
    .c9-circle-stage.is-detail-mode #flow-canvas {
      height: 256px;
    }
    .c9-fractal-detail-panel {
      position: static;
      width: auto;
      margin: 0 14px 14px;
      border-radius: 6px;
    }
  }
</style>

<script id="nine-functions-data" type="application/json" set:html={safeJson} />
<script>
  import { initNineFunctionsJourney } from '../scripts/nine-functions-canvas.js';

  const root = document.getElementById('nine-functions-root');
  const dataNode = document.getElementById('nine-functions-data');
  if (root && dataNode) {
    const items = JSON.parse(dataNode.textContent || '[]');
    initNineFunctionsJourney(root, items);
  }
</script>

