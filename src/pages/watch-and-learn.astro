---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/watch-and-learn.json';
import { withBase } from '../utils/url';
---
<BaseLayout
  title={page.page_title}
  currentHref="/watch-and-learn.html"
  navMode="phase2"
  headerMaxWidth={1080}
  footerExtra="Staging build · Consultation booking, contact details, and legal policies will be linked after approval."
>
  <style slot="head">
    main { max-width: 1080px; margin: auto; padding: 30px 22px 85px; font-size: 16px; line-height: 1.65; }
    .hero { padding: 55px 0 40px; border-bottom: 1px solid #ddd; }
    h1 { font-size: clamp(2.2rem, 5vw, 3.7rem); line-height: 1.14; margin: 10px 0; }
    h2 { font-size: 1.8rem; line-height: 1.2; }
    .eyebrow { color: #977342; text-transform: uppercase; letter-spacing: .15em; font-size: .8rem; font-weight: 700; }
    .section { padding-top: 42px; }
    .button {
      display: inline-block;
      background: #b79a69;
      color: #15243a;
      text-decoration: none;
      font-weight: 650;
      border: 0;
      border-radius: 3px;
      padding: 12px 19px;
      margin: 8px 8px 8px 0;
      cursor: pointer;
    }
    .button.alt { background: #15243a; color: white; }
    .media {
      aspect-ratio: 16 / 9;
      background: #e6e7e8;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 24px;
      border: 1px solid #d4d7da;
      color: #42536a;
    }
    .note { padding: 15px 18px; background: #eee9df; border-left: 3px solid #b79a69; }
    @media (max-width: 700px) {
      .hero { padding: 32px 0; }
    }
  </style>

  <main>
    <section class="hero">
      <div class="eyebrow">{page.eyebrow}</div>
      <h1>{page.heading}</h1>
      <p><strong>{page.hosts_label}</strong></p>
      <p>{page.intro}</p>
    </section>

    <section class="section">
      <h2>{page.section_heading}</h2>
      {page.youtube_playlist_url ? (
        <p><a class="button" href={page.youtube_playlist_url} target="_blank" rel="noopener noreferrer">Open Watch &amp; Learn Playlist →</a></p>
      ) : (
        <div class="media" role="img" aria-label="YouTube playlist placeholder">{page.video_placeholder}</div>
      )}
      <p class="note">{page.video_note}</p>
    </section>

    <section class="section">
      <h2>{page.continue_heading}</h2>
      <a class="button" href={withBase('/shows.html')}>Meet the Fictional Shows</a>
      <a class="button alt" href={withBase('/assessments/index.html')}>Explore Assessments</a>
    </section>
  </main>
</BaseLayout>

