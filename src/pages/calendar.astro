---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/calendar.json';
---
<BaseLayout
  title={page.page_title}
  currentHref="/calendar.html"
  navMode="phase2"
  headerMaxWidth={1080}
  footerExtra="Staging build · Consultation booking, contact details, and legal policies will be linked after approval."
>
  <style slot="head">
    main { max-width: 1080px; margin: auto; padding: 30px 22px 85px; font-size: 16px; line-height: 1.65; }
    .hero { padding: 55px 0 40px; border-bottom: 1px solid #ddd; }
    h1 { font-size: clamp(2.2rem, 5vw, 3.7rem); line-height: 1.14; margin: 10px 0; }
    h2 { font-size: 1.8rem; line-height: 1.2; }
    h3 { font-size: 1.2rem; }
    .eyebrow { color: #977342; text-transform: uppercase; letter-spacing: .15em; font-size: .8rem; font-weight: 700; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .card { padding: 26px; background: white; border: 1px solid #d8d5ce; border-left: 3px solid #b79a69; }
    .card p { margin-top: 0; }
    .section { padding-top: 42px; }
    .button {
      display: inline-block;
      background: #b79a69;
      color: #15243a;
      text-decoration: none;
      font-weight: 650;
      border: 0;
      border-radius: 3px;
      padding: 12px 19px;
      margin: 14px 8px 8px 0;
      cursor: pointer;
    }
    .media {
      aspect-ratio: 16 / 9;
      background: #e6e7e8;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 24px;
      border: 1px solid #d4d7da;
      color: #42536a;
    }
    .muted { color: #536070; }
    .result { font-size: 1.5rem; font-weight: 700; }
    label { display: block; font-weight: 600; margin-bottom: 5px; }
    select, input {
      font: inherit;
      padding: 10px;
      width: 100%;
      max-width: 260px;
      border: 1px solid #999;
      border-radius: 3px;
    }
    .inputs { display: flex; gap: 16px; flex-wrap: wrap; }
    @media (max-width: 700px) {
      .grid { grid-template-columns: 1fr; }
      .hero { padding: 32px 0; }
    }
  </style>

  <main>
    <section class="hero">
      <div class="eyebrow" data-editable="text" data-prop="hero_eyebrow">{page.hero_eyebrow}</div>
      <h1 data-editable="text" data-prop="hero_heading">{page.hero_heading}</h1>
      <p data-editable="text" data-prop="hero_intro">{page.hero_intro}</p>
    </section>

    <section class="section">
      <h2 data-editable="text" data-prop="video_heading">{page.video_heading}</h2>
      {page.youtube_playlist_url ? (
        <p><a class="button" href={page.youtube_playlist_url} target="_blank" rel="noopener noreferrer">Open Calendar Video Playlist →</a></p>
      ) : (
        <div class="media" role="img" aria-label="Calendar YouTube video placeholder" data-editable="text" data-prop="video_placeholder">{page.video_placeholder}</div>
      )}
    </section>

    <section class="section">
      <h2 data-editable="text" data-prop="calculator_heading">{page.calculator_heading}</h2>
      <p>Add the individual digits of your <strong>birth month, birth day, and the calendar year</strong>. Keep adding until you get a single number from 1 to 9.</p>
      <p><strong>Example: Born June 13 | Year 2027</strong></p>
      <p>6 + 1 + 3 + 2 + 0 + 2 + 7 = 21<br>2 + 1 = <strong>3</strong></p>
      <h3>Select Your Calendar</h3>
      <p>Your Personal Cycle Year is <strong>3</strong>, so choose <strong>Calendar 3 for 2027</strong>.</p>
      <p>Recalculate each year to find your new calendar.</p>

      <div class="card">
        <h3 data-editable="text" data-prop="calculator_card_title">{page.calculator_card_title}</h3>
        <form id="cycle-form">
          <div class="inputs">
            <div>
              <label for="birth-month">Birth month</label>
              <select id="birth-month" required>
                <option value="">Select month</option>
                <option value="1">January</option>
                <option value="2">February</option>
                <option value="3">March</option>
                <option value="4">April</option>
                <option value="5">May</option>
                <option value="6">June</option>
                <option value="7">July</option>
                <option value="8">August</option>
                <option value="9">September</option>
                <option value="10">October</option>
                <option value="11">November</option>
                <option value="12">December</option>
              </select>
            </div>
            <div>
              <label for="birth-day">Birth day</label>
              <select id="birth-day" required>
                <option value="">Select day</option>
                {Array.from({ length: 31 }, (_, i) => i + 1).map((d) => (
                  <option value={String(d)}>{d}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="calendar-year">Calendar year</label>
              <input id="calendar-year" type="number" min="1900" max="9999" value="2027" required>
            </div>
          </div>
          <button class="button" type="submit">{page.calculator_button_label}</button>
        </form>
        <div id="cycle-result" role="status" aria-live="polite"></div>
      </div>
    </section>

    <section class="section">
      <h2 data-editable="text" data-prop="explore_heading">{page.explore_heading}</h2>
      <p data-editable="text" data-prop="explore_intro">{page.explore_intro}</p>
      <div class="grid" data-editable="array" data-prop="cards" data-direction="row">
        {page.cards.map((card) => (
          <article class="card" data-editable="array-item">
            <h3 data-editable="text" data-prop="title">{card.title}</h3>
            <p data-editable="text" data-prop="description">{card.description}</p>
            <p class="muted" data-editable="text" data-prop="status_note">{card.status_note}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      const form = document.getElementById('cycle-form');
      const result = document.getElementById('cycle-result');
      function digitSum(n) {
        return String(n).split('').reduce((s, d) => s + Number(d), 0);
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const m = Number(document.getElementById('birth-month').value);
        const d = Number(document.getElementById('birth-day').value);
        const y = Number(document.getElementById('calendar-year').value);
        if (!m || !d || !Number.isInteger(y) || y < 1900 || y > 9999 || d > new Date(2024, m, 0).getDate()) {
          result.textContent = 'Please enter a valid birth month, birth day, and calendar year.';
          return;
        }
        let n = digitSum(m) + digitSum(d) + digitSum(y);
        while (n > 9) n = digitSum(n);
        result.innerHTML =
          '<p class="result">Your Personal Cycle Year: ' + n + '</p>' +
          '<p>Select <strong>Calendar ' + n + ' for ' + y + '</strong>.</p>' +
          '<p class="muted">The matching calendar purchase link will be available when the product catalog is connected.</p>';
      });
    })();
  </script>
</BaseLayout>

