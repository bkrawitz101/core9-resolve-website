---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/functions.json';
---
<BaseLayout
  title={page.page_title}
  currentHref="/functions.html"
  navMode="phase2"
  bodyBackground="#f7f6f3"
  headerMaxWidth={1120}
  footerExtra="CORE9 RESOLVE™ · Interactive Circle of Nine."
>
  <style slot="head">
    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: clamp(32px, 5vw, 52px) 22px 76px;
      color: #172338;
    }
    .page-intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 28px;
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: .78rem;
      color: #8d6b39;
      font-weight: 650;
      margin: 0 0 8px;
    }
    h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.9rem, 4vw, 2.85rem);
      line-height: 1.15;
      margin: 0 0 12px;
      color: #15243a;
    }
    .page-intro p.lead {
      font-size: 1.06rem;
      color: #44505e;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Fixed Circle of Nine Stage (CORE9 midnight navy + champagne gold) */
    .circle-stage {
      position: relative;
      background: #15243a;
      border: 1px solid rgba(183, 154, 105, 0.35);
      border-top: 3px solid #b79a69;
      border-radius: 8px;
      height: clamp(500px, 68vh, 630px);
      overflow: hidden;
      box-shadow: 0 20px 44px rgba(21, 36, 58, 0.14);
    }
    #flow-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Fractaled-in Explanation Overlay (aligned cleanly on right half on desktop) */
    .fractal-detail-panel {
      position: absolute;
      top: 24px;
      right: 24px;
      bottom: 24px;
      width: min(510px, 52%);
      background: #ffffff;
      border: 1px solid #e4dfd5;
      border-top: 4px solid #b79a69;
      border-radius: 6px;
      padding: clamp(22px, 3vw, 32px);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      box-shadow: 0 18px 40px rgba(10, 20, 34, 0.32);
      opacity: 0;
      transform: scale(0.96);
      transition: opacity 240ms ease, transform 240ms ease;
    }
    .fractal-detail-panel[hidden] {
      display: none;
    }
    .fractal-detail-panel.is-visible {
      opacity: 1;
      transform: scale(1);
    }
    .detail-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .detail-tag {
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #8d6b39;
    }
    .btn-back {
      background: transparent;
      border: 1px solid #d7d3ca;
      color: #15243a;
      border-radius: 3px;
      padding: 6px 12px;
      font-size: .82rem;
      font-weight: 650;
      cursor: pointer;
    }
    .btn-back:hover {
      border-color: #b79a69;
      background: #f3eee3;
    }
    .fractal-detail-panel h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.45rem, 2.5vw, 1.9rem);
      line-height: 1.2;
      color: #15243a;
      margin: 0 0 8px;
    }
    .detail-question {
      font-family: Georgia, "Times New Roman", serif;
      font-style: italic;
      font-size: 1.08rem;
      color: #806a4a;
      margin: 0 0 14px;
      line-height: 1.4;
    }
    .detail-copy {
      font-size: .97rem;
      color: #172338;
      line-height: 1.62;
      margin: 0 0 12px;
    }
    .detail-copy.muted {
      color: #44505e;
    }
    .detail-scales {
      background: #f7f6f3;
      border-left: 3px solid #b79a69;
      padding: 10px 14px;
      font-size: .88rem;
      color: #283442;
      margin: 4px 0 14px;
      line-height: 1.5;
    }
    .detail-flow-badge {
      display: inline-block;
      align-self: flex-start;
      background: #f3eee3;
      border: 1px solid #dfd3bd;
      border-radius: 999px;
      padding: 4px 12px;
      font-size: .8rem;
      font-weight: 650;
      color: #15243a;
      margin-bottom: 18px;
    }
    .detail-actions {
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid #ebe6dc;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .btn-step {
      background: #f7f6f3;
      border: 1px solid #d7d3ca;
      color: #15243a;
      border-radius: 3px;
      padding: 10px 13px;
      font-size: .86rem;
      font-weight: 650;
      cursor: pointer;
    }
    .btn-step:hover {
      border-color: #b79a69;
      background: #f3eee3;
    }
    .button {
      flex: 1 1 auto;
      text-align: center;
      display: inline-block;
      padding: 11px 18px;
      border: 1px solid #b79a69;
      background: #b79a69;
      color: #15243a;
      text-decoration: none;
      font-weight: 650;
      font-size: .92rem;
      border-radius: 3px;
    }
    .button:hover,
    .button:focus-visible {
      background: #a58856;
      border-color: #a58856;
    }

    /* Quick Step Strip below stage */
    .step-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 18px 0 38px;
    }
    .step-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid #dfd3bd;
      color: #15243a;
      font-size: .84rem;
      font-weight: 600;
      cursor: pointer;
    }
    .step-pill span {
      color: #8d6b39;
      font-weight: 700;
    }
    .step-pill:hover {
      border-color: #b79a69;
      background: #f3eee3;
    }
    .step-pill.is-active {
      background: #15243a;
      border-color: #15243a;
      color: #ffffff;
    }
    .step-pill.is-active span {
      color: #d7bc8c;
    }

    /* Editable Reference Grid (CORE9 card aesthetic) */
    .notice-bar {
      background: #eee9df;
      border-left: 3px solid #b79a69;
      padding: 12px 18px;
      font-size: .94rem;
      color: #283442;
      max-width: 780px;
      margin: 0 auto 28px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .tile {
      display: flex;
      flex-direction: column;
      border: 1px solid #e4dfd5;
      border-top: 3px solid #b79a69;
      background: #ffffff;
      padding: 20px;
      border-radius: 6px;
      box-shadow: 0 12px 28px rgba(21, 36, 58, 0.06);
      text-decoration: none;
      color: inherit;
    }
    .tile:hover,
    .tile:focus-visible {
      border-color: #b79a69;
      box-shadow: 0 14px 32px rgba(21, 36, 58, 0.12);
    }
    .tile-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .num {
      font-size: .78rem;
      font-weight: 700;
      color: #8d6b39;
      letter-spacing: .08em;
    }
    .flow-pill {
      font-size: .72rem;
      font-weight: 650;
      color: #15243a;
      background: #f3eee3;
      border: 1px solid #dfd3bd;
      border-radius: 999px;
      padding: 2px 9px;
    }
    .name {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.18rem;
      font-weight: 700;
      color: #15243a;
      margin-bottom: 6px;
    }
    .tile-q {
      font-style: italic;
      font-size: .9rem;
      color: #806a4a;
      margin-bottom: 8px;
    }
    .tile-sum {
      font-size: .9rem;
      color: #44505e;
      line-height: 1.55;
      margin-bottom: 14px;
    }
    .open {
      margin-top: auto;
      font-size: .88rem;
      font-weight: 650;
      color: #15243a;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .closing {
      text-align: center;
      max-width: 680px;
      margin: 0 auto;
      color: #44505e;
      font-size: .98rem;
    }

    @media (max-width: 900px) {
      .circle-stage {
        height: auto;
        min-height: 460px;
        display: flex;
        flex-direction: column;
      }
      .circle-stage #flow-canvas {
        height: 460px;
        flex: 0 0 auto;
      }
      .circle-stage.is-detail-mode #flow-canvas {
        height: 256px;
      }
      .fractal-detail-panel {
        position: static;
        width: auto;
        margin: 0 14px 14px;
        border-radius: 6px;
      }
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main id="nine-functions-root">
    <div class="page-intro">
      <p class="eyebrow" data-editable="text" data-prop="eyebrow">{page.eyebrow}</p>
      <h1 data-editable="text" data-prop="heading">{page.heading}</h1>
      <p class="lead" data-editable="text" data-prop="intro">{page.intro}</p>
    </div>

    <section id="circle-stage" class="circle-stage" aria-label="Interactive Circle of Nine">
      <canvas id="flow-canvas" aria-label="Circle of Nine — select a function to fractal in"></canvas>

      <aside id="fractal-detail-panel" class="fractal-detail-panel" hidden aria-live="polite">
        <div class="detail-top-bar">
          <span id="detail-tag" class="detail-tag">{page.tiles[0].role_tag}</span>
          <button type="button" id="btn-back-circle" class="btn-back">← Back to Circle of Nine</button>
        </div>

        <h2 id="detail-title">{page.tiles[0].num}. {page.tiles[0].name}</h2>
        <p id="detail-question" class="detail-question">{page.tiles[0].question}</p>
        <p id="detail-summary" class="detail-copy">{page.tiles[0].summary}</p>
        <p id="detail-explanation" class="detail-copy muted">{page.tiles[0].explanation}</p>
        <div id="detail-scales" class="detail-scales">{page.tiles[0].scales_note}</div>
        <div id="detail-flow" class="detail-flow-badge">{page.tiles[0].flow_label}</div>

        <div class="detail-actions">
          <button type="button" id="btn-prev-fn" class="btn-step">← Prev</button>
          <button type="button" id="btn-next-fn" class="btn-step">Next →</button>
          <a id="detail-story-link" class="button" href={page.tiles[0].href} target="_blank" rel="noopener noreferrer">
            Open Function {page.tiles[0].num} Interactive Story →
          </a>
        </div>
      </aside>
    </section>

    <nav class="step-strip" aria-label="Select a function on the circle">
      {page.tiles.map((tile, idx) => (
        <button
          type="button"
          class="step-pill"
          data-fn-index={idx}
          aria-pressed="false"
        >
          <span>{tile.num}</span> {tile.name}
        </button>
      ))}
    </nav>

    <aside class="notice-bar">
      <strong data-editable="text" data-prop="notice_prefix">{page.notice_prefix}</strong>
      <span data-editable="text" data-prop="notice_body">{page.notice_body}</span>
    </aside>

    <div class="grid" data-editable="array" data-prop="tiles" data-direction="row">
      {page.tiles.map((tile) => (
        <a class="tile" href={tile.href} target="_blank" rel="noopener noreferrer" data-editable="array-item">
          <div class="tile-meta">
            <span class="num">FUNCTION <span data-editable="text" data-prop="num">{tile.num}</span></span>
            <span class="flow-pill" data-editable="text" data-prop="flow_label">{tile.flow_label}</span>
          </div>
          <span class="name" data-editable="text" data-prop="name">{tile.name}</span>
          <span class="tile-q" data-editable="text" data-prop="question">{tile.question}</span>
          <span class="tile-sum" data-editable="text" data-prop="summary">{tile.summary}</span>
          <span class="open">Open Interactive Story →</span>
        </a>
      ))}
    </div>

    <p class="closing" data-editable="text" data-prop="closing">{page.closing}</p>
  </main>

  <script id="nine-functions-data" type="application/json" set:html={JSON.stringify(page.tiles)} />
  <script>
    import { initNineFunctionsJourney } from '../scripts/nine-functions-canvas.js';

    const root = document.getElementById('nine-functions-root');
    const dataNode = document.getElementById('nine-functions-data');
    if (root && dataNode) {
      const items = JSON.parse(dataNode.textContent || '[]');
      initNineFunctionsJourney(root, items);
    }
  </script>
</BaseLayout>
