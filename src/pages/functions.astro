---
import BaseLayout from '../layouts/BaseLayout.astro';
import CircleOfNineStage from '../components/CircleOfNineStage.astro';
import page from '../data/pages/functions.json';
---
<BaseLayout
  title={page.page_title}
  currentHref="/functions.html"
  navMode="phase2"
  bodyBackground="#f7f6f3"
  headerMaxWidth={1120}
  footerExtra="CORE9 RESOLVE™ · Interactive Circle of Nine."
>
  <style slot="head">
    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: clamp(32px, 5vw, 52px) 22px 76px;
      color: #172338;
    }
    .page-intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 28px;
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: .78rem;
      color: #8d6b39;
      font-weight: 650;
      margin: 0 0 8px;
    }
    h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.9rem, 4vw, 2.85rem);
      line-height: 1.15;
      margin: 0 0 12px;
      color: #15243a;
    }
    .page-intro p.lead {
      font-size: 1.06rem;
      color: #44505e;
      margin: 0 auto;
      line-height: 1.6;
    }
    .notice-bar {
      background: #eee9df;
      border-left: 3px solid #b79a69;
      padding: 12px 18px;
      font-size: .94rem;
      color: #283442;
      max-width: 780px;
      margin: 34px auto 28px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .tile {
      display: flex;
      flex-direction: column;
      border: 1px solid #e4dfd5;
      border-top: 3px solid #b79a69;
      background: #ffffff;
      padding: 20px;
      border-radius: 6px;
      box-shadow: 0 12px 28px rgba(21, 36, 58, 0.06);
      text-decoration: none;
      color: inherit;
    }
    .tile:hover,
    .tile:focus-visible {
      border-color: #b79a69;
      box-shadow: 0 14px 32px rgba(21, 36, 58, 0.12);
    }
    .tile-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .num {
      font-size: .78rem;
      font-weight: 700;
      color: #8d6b39;
      letter-spacing: .08em;
    }
    .flow-pill {
      font-size: .72rem;
      font-weight: 650;
      color: #15243a;
      background: #f3eee3;
      border: 1px solid #dfd3bd;
      border-radius: 999px;
      padding: 2px 9px;
    }
    .name {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.18rem;
      font-weight: 700;
      color: #15243a;
      margin-bottom: 6px;
    }
    .tile-q {
      font-style: italic;
      font-size: .9rem;
      color: #806a4a;
      margin-bottom: 8px;
    }
    .tile-sum {
      font-size: .9rem;
      color: #44505e;
      line-height: 1.55;
      margin-bottom: 14px;
    }
    .open {
      margin-top: auto;
      font-size: .88rem;
      font-weight: 650;
      color: #15243a;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .closing {
      text-align: center;
      max-width: 680px;
      margin: 0 auto;
      color: #44505e;
      font-size: .98rem;
    }
    @media (max-width: 900px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
    <div class="page-intro">
      <p class="eyebrow" data-editable="text" data-prop="eyebrow">{page.eyebrow}</p>
      <h1 data-editable="text" data-prop="heading">{page.heading}</h1>
      <p class="lead" data-editable="text" data-prop="intro">{page.intro}</p>
    </div>

    <CircleOfNineStage tiles={page.tiles} />

    <aside class="notice-bar">
      <strong data-editable="text" data-prop="notice_prefix">{page.notice_prefix}</strong>
      <span data-editable="text" data-prop="notice_body">{page.notice_body}</span>
    </aside>

    <div class="grid" data-editable="array" data-prop="tiles" data-direction="row">
      {page.tiles.map((tile) => (
        <a class="tile" href={tile.href} target="_blank" rel="noopener noreferrer" data-editable="array-item">
          <div class="tile-meta">
            <span class="num">FUNCTION <span data-editable="text" data-prop="num">{tile.num}</span></span>
            <span class="flow-pill" data-editable="text" data-prop="flow_label">{tile.flow_label}</span>
          </div>
          <span class="name" data-editable="text" data-prop="name">{tile.name}</span>
          <span class="tile-q" data-editable="text" data-prop="question">{tile.question}</span>
          <span class="tile-sum" data-editable="text" data-prop="summary">{tile.summary}</span>
          <span class="open">Open Interactive Story →</span>
        </a>
      ))}
    </div>

    <p class="closing" data-editable="text" data-prop="closing">{page.closing}</p>
  </main>
</BaseLayout>
