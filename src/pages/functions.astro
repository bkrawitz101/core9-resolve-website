---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/functions.json';
---
<BaseLayout
  title={page.page_title}
  currentHref="/functions.html"
  navMode="phase2"
  bodyBackground="#020403"
  headerMaxWidth={1280}
  footerExtra="Interactive system map · Explore any function story in depth."
>
  <style slot="head">
    .journey-shell {
      position: relative;
      background: #020403;
      color: #f4f4f5;
      border-bottom: 1px solid rgba(52, 211, 153, 0.14);
    }
    .canvas-stage {
      position: relative;
      width: 100%;
      height: clamp(540px, 76vh, 760px);
      overflow: hidden;
      background: #020403;
    }
    #flow-canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
    }
    .hud-header {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 10;
      max-width: 420px;
      padding: 16px 18px;
      border-radius: 16px;
      background: rgba(9, 9, 11, 0.78);
      border: 1px solid rgba(52, 211, 153, 0.22);
      backdrop-filter: blur(12px);
      pointer-events: auto;
    }
    .hud-eyebrow {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: #34d399;
      margin: 0 0 6px;
    }
    .hud-header h1 {
      font-size: clamp(1.25rem, 2.3vw, 1.75rem);
      line-height: 1.18;
      margin: 0 0 8px;
      color: #ffffff;
    }
    .hud-header p {
      margin: 0;
      font-size: .88rem;
      line-height: 1.5;
      color: #a1a1aa;
    }
    .inspector-card {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 10;
      width: min(370px, calc(100vw - 40px));
      padding: 18px 20px;
      border-radius: 18px;
      background: rgba(9, 9, 11, 0.84);
      border: 1px solid rgba(52, 211, 153, 0.26);
      box-shadow: 0 0 40px rgba(16, 185, 129, 0.12);
      backdrop-filter: blur(14px);
    }
    .inspector-tag {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #6ee7b7;
      margin-bottom: 4px;
    }
    .inspector-card h2 {
      font-size: 1.25rem;
      margin: 0 0 8px;
      color: #ffffff;
      line-height: 1.25;
    }
    .inspector-question {
      font-size: .95rem;
      font-weight: 600;
      color: #e4e4e7;
      margin: 0 0 8px;
      line-height: 1.4;
    }
    .inspector-summary {
      font-size: .86rem;
      color: #a1a1aa;
      margin: 0 0 12px;
      line-height: 1.5;
    }
    .inspector-flow {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      color: #67e8f9;
      background: rgba(34, 211, 238, 0.08);
      border: 1px solid rgba(34, 211, 238, 0.22);
      border-radius: 8px;
      padding: 6px 10px;
      margin-bottom: 14px;
    }
    .inspector-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .btn-ghost {
      background: rgba(24, 24, 27, 0.9);
      color: #d4d4d8;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 10px;
      padding: 8px 11px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-ghost:hover {
      border-color: rgba(52, 211, 153, 0.45);
      color: #6ee7b7;
    }
    .btn-primary-glow {
      flex: 1 1 auto;
      text-align: center;
      text-decoration: none;
      background: #10b981;
      color: #020403;
      border-radius: 10px;
      padding: 9px 14px;
      font-size: 13px;
      font-weight: 700;
      box-shadow: 0 0 18px rgba(16, 185, 129, 0.35);
    }
    .btn-primary-glow:hover {
      background: #34d399;
    }
    .cam-controls {
      position: absolute;
      bottom: 66px;
      left: 20px;
      z-index: 10;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      padding: 6px;
      border-radius: 12px;
      background: rgba(9, 9, 11, 0.82);
      border: 1px solid rgba(52, 211, 153, 0.22);
      backdrop-filter: blur(10px);
    }
    .cam-btn {
      background: transparent;
      color: #6ee7b7;
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 6px 10px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .cam-btn:hover {
      background: rgba(16, 185, 129, 0.14);
    }
    .cam-btn.is-active {
      background: rgba(16, 185, 129, 0.2);
      border-color: rgba(52, 211, 153, 0.4);
      color: #a7f3d0;
    }
    .orbit-hint {
      position: absolute;
      bottom: 68px;
      right: 20px;
      z-index: 10;
      padding: 6px 11px;
      border-radius: 10px;
      background: rgba(9, 9, 11, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      color: #a1a1aa;
      pointer-events: none;
    }
    .journey-strip {
      position: relative;
      z-index: 10;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 12px 20px;
      background: rgba(9, 9, 11, 0.96);
      border-top: 1px solid rgba(52, 211, 153, 0.16);
      justify-content: center;
      flex-wrap: wrap;
    }
    .journey-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 11px;
      border-radius: 999px;
      background: rgba(24, 24, 27, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #d4d4d8;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11.5px;
      cursor: pointer;
      white-space: nowrap;
    }
    .journey-pill span {
      color: #34d399;
      font-weight: 700;
    }
    .journey-pill:hover {
      border-color: rgba(52, 211, 153, 0.45);
      color: #ffffff;
    }
    .journey-pill.is-active {
      background: rgba(16, 185, 129, 0.2);
      border-color: #34d399;
      color: #ffffff;
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.25);
    }

    /* Editorial Reference Index below canvas (also preserves CloudCannon editable array) */
    .reference-band {
      background: #090d12;
      color: #e4e4e7;
      padding: 48px 24px 72px;
    }
    .reference-inner {
      max-width: 1200px;
      margin: 0 auto;
    }
    .notice-bar {
      background: rgba(16, 185, 129, 0.08);
      border-left: 3px solid #34d399;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      font-size: .92rem;
      color: #cbd5e1;
      margin-bottom: 28px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }
    .tile {
      background: rgba(18, 23, 30, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-top: 2px solid rgba(52, 211, 153, 0.55);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      border-radius: 10px;
      text-decoration: none;
      color: inherit;
    }
    .tile:hover {
      border-color: rgba(52, 211, 153, 0.5);
      box-shadow: 0 10px 28px rgba(16, 185, 129, 0.12);
    }
    .tile-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
    }
    .num {
      color: #34d399;
      font-weight: 700;
    }
    .flow-badge {
      color: #67e8f9;
      background: rgba(34, 211, 238, 0.1);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .name {
      font-size: 1.15rem;
      font-weight: 700;
      color: #ffffff;
    }
    .tile-q {
      font-size: .92rem;
      color: #cbd5e1;
      font-weight: 600;
    }
    .tile-sum {
      font-size: .85rem;
      color: #94a3b8;
      line-height: 1.5;
    }
    .open {
      margin-top: auto;
      padding-top: 8px;
      font-size: .86rem;
      color: #6ee7b7;
      font-weight: 650;
    }
    .closing-note {
      color: #94a3b8;
      font-size: .95rem;
      max-width: 740px;
    }
    @media (max-width: 960px) {
      .canvas-stage {
        height: 460px;
      }
      .hud-header {
        position: static;
        max-width: none;
        border-radius: 0;
        border-left: 0;
        border-right: 0;
        border-top: 0;
      }
      .inspector-card {
        position: static;
        width: auto;
        border-radius: 0;
        border-left: 0;
        border-right: 0;
      }
      .cam-controls {
        bottom: 14px;
        left: 14px;
      }
      .orbit-hint {
        display: none;
      }
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main id="nine-functions-root">
    <section class="journey-shell" aria-label="Interactive Nine Functions Orbital Flow">
      <div class="hud-header">
        <p class="hud-eyebrow" data-editable="text" data-prop="eyebrow">{page.eyebrow}</p>
        <h1 data-editable="text" data-prop="heading">{page.heading}</h1>
        <p data-editable="text" data-prop="intro">{page.intro}</p>
      </div>

      <div class="canvas-stage">
        <canvas id="flow-canvas" aria-label="3D bioluminescent orbital map of the Nine Functions"></canvas>

        <div class="cam-controls" role="toolbar" aria-label="Canvas camera controls">
          <button type="button" id="btn-zoom-in" class="cam-btn" title="Zoom In">+</button>
          <button type="button" id="btn-zoom-out" class="cam-btn" title="Zoom Out">−</button>
          <button type="button" id="btn-reset-cam" class="cam-btn" title="Reset Camera">Reset</button>
          <button type="button" id="btn-toggle-rotate" class="cam-btn is-active" aria-pressed="true" title="Toggle Auto-Rotate">Auto-Orbit</button>
          <button type="button" id="btn-toggle-mode" class="cam-btn" title="Switch 2D / 3D">2D View</button>
        </div>

        <div class="orbit-hint">Drag to orbit 3D · Scroll to zoom · Click any node</div>
      </div>

      <aside class="inspector-card" aria-live="polite">
        <div id="inspector-tag" class="inspector-tag">{page.tiles[0].role_tag}</div>
        <h2 id="inspector-title">{page.tiles[0].num}. {page.tiles[0].name}</h2>
        <p id="inspector-question" class="inspector-question">{page.tiles[0].question}</p>
        <p id="inspector-summary" class="inspector-summary">{page.tiles[0].summary}</p>
        <div id="inspector-flow" class="inspector-flow">
          Flows to {page.tiles[1].num}. {page.tiles[1].name} ({page.tiles[0].flow_label})
        </div>
        <div class="inspector-actions">
          <button type="button" id="btn-prev-fn" class="btn-ghost">← Prev</button>
          <button type="button" id="btn-next-fn" class="btn-ghost">Next →</button>
          <a id="inspector-story-link" class="btn-primary-glow" href={page.tiles[0].href} target="_blank" rel="noopener noreferrer">
            Open Function {page.tiles[0].num} Story →
          </a>
        </div>
      </aside>

      <nav class="journey-strip" aria-label="Jump to function step">
        {page.tiles.map((tile, idx) => (
          <button
            type="button"
            class={`journey-pill${idx === 0 ? ' is-active' : ''}`}
            data-fn-index={idx}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            <span>{tile.num}</span> {tile.name}
          </button>
        ))}
      </nav>
    </section>

    <section class="reference-band">
      <div class="reference-inner">
        <div class="notice-bar">
          <strong data-editable="text" data-prop="notice_prefix">{page.notice_prefix}</strong>
          <span data-editable="text" data-prop="notice_body">{page.notice_body}</span>
        </div>

        <div class="grid" data-editable="array" data-prop="tiles" data-direction="row">
          {page.tiles.map((tile) => (
            <a class="tile" href={tile.href} target="_blank" rel="noopener noreferrer" data-editable="array-item">
              <div class="tile-top">
                <span class="num" data-editable="text" data-prop="num">{tile.num}</span>
                <span class="flow-badge" data-editable="text" data-prop="flow_label">{tile.flow_label}</span>
              </div>
              <span class="name" data-editable="text" data-prop="name">{tile.name}</span>
              <span class="tile-q" data-editable="text" data-prop="question">{tile.question}</span>
              <span class="tile-sum" data-editable="text" data-prop="summary">{tile.summary}</span>
              <span class="open">Open Interactive Story →</span>
            </a>
          ))}
        </div>

        <p class="closing-note" data-editable="text" data-prop="closing">{page.closing}</p>
      </div>
    </section>
  </main>

  <script id="nine-functions-data" type="application/json" set:html={JSON.stringify(page.tiles)} />
  <script>
    import { initNineFunctionsJourney } from '../scripts/nine-functions-canvas.js';

    const root = document.getElementById('nine-functions-root');
    const dataNode = document.getElementById('nine-functions-data');
    if (root && dataNode) {
      const items = JSON.parse(dataNode.textContent || '[]');
      initNineFunctionsJourney(root, items);
    }
  </script>
</BaseLayout>
