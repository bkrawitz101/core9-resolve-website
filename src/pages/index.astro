---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReflectionCard from '../components/ReflectionCard.astro';
import home from '../data/pages/home.json';
---
<BaseLayout title={home.page_title} currentHref="/index.html" navMode="primary">
  <style is:global slot="head">
    main section {
      padding: clamp(44px, 6vw, 72px) max(22px, calc((100vw - 960px) / 2));
      text-align: center;
    }
    .hero {
      background: #17263d;
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .hero-pillars {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      margin: 0 auto 22px;
      font-size: clamp(1.7rem, 3.8vw, 2.6rem);
      font-weight: 700;
      letter-spacing: -.015em;
      line-height: 1.2;
      color: #f3efe7;
    }
    .hero-pillars span {
      display: block;
    }
    .hero-turn {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      line-height: 1.2;
      font-weight: 600;
      color: #ffffff;
      max-width: 760px;
      margin: 0 auto 20px;
    }
    .hero-turn em {
      font-style: italic;
      color: #d7bc8c;
    }
    .hero-divider {
      width: 56px;
      height: 2px;
      background: #b79a69;
      margin: 18px auto 16px;
    }
    .hero-sub {
      max-width: 700px;
      font-size: 1.12rem;
      line-height: 1.65;
      color: #cfd7e3;
      margin: 0 auto;
    }
    .hero-sub strong {
      color: #ffffff;
      font-weight: 650;
    }
    .hero-sub .outcome {
      color: #e4cb9c;
      font-weight: 650;
      border-bottom: 1px solid rgba(215, 188, 140, 0.5);
      padding-bottom: 1px;
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: .78rem;
      color: #8d6b39;
      font-weight: 650;
    }
    h2 {
      font-size: clamp(1.7rem, 3vw, 2.6rem);
      line-height: 1.18;
      margin: 8px auto 18px;
      max-width: 740px;
      color: #15243a;
    }
    .split-heading span { display: block; }
    .split-heading .accent { color: #8d6b39; }
    main p { max-width: 660px; font-size: 1.08rem; margin: 0 auto 14px; }
    .button {
      display: inline-block;
      padding: 13px 22px;
      border: 1px solid #b79a69;
      background: #b79a69;
      color: #15243a;
      text-decoration: none;
      font-weight: 650;
      border-radius: 3px;
    }
    .explore {
      background: #f7f6f3;
      padding-bottom: clamp(56px, 7vw, 84px);
    }
    .function-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-top: 28px;
      text-align: left;
    }
    .test-card {
      display: flex;
      flex-direction: column;
      border: 1px solid #e4dfd5;
      border-top: 3px solid #b79a69;
      background: #ffffff;
      padding: 22px;
      border-radius: 6px;
      box-shadow: 0 16px 36px rgba(21, 36, 58, 0.11);
    }
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 4px;
    }
    .card-meta small { display: block; color: #806a4a; font-weight: 650; letter-spacing: .04em; }
    .count-pill {
      font-size: .78rem;
      font-weight: 650;
      color: #15243a;
      background: #f3eee3;
      border: 1px solid #dfd3bd;
      border-radius: 999px;
      padding: 3px 10px;
      white-space: nowrap;
    }
    .test-card strong { display: block; font-size: 1.2rem; margin: 6px 0 8px; color: #15243a; }
    .test-card .desc { display: block; font-size: .96rem; color: #44505e; margin-bottom: 18px; }
    .test-card .button {
      margin-top: auto;
      text-align: center;
      display: block;
    }
    .test-card .button:hover,
    .test-card .button:focus-visible {
      background: #a58856;
      border-color: #a58856;
    }
    .footnote {
      margin: 28px auto 0;
      font-size: .98rem;
      color: #44505e;
    }
    .footnote a {
      color: #15243a;
      font-weight: 650;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    @media (max-width: 700px) {
      .function-grid { grid-template-columns: 1fr; }
    }
  </style>

  <main>
    <section class="hero" id="home">
      <div class="hero-pillars">
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_line_1">{home.hero_line_1}</span>
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_line_2">{home.hero_line_2}</span>
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_line_3">{home.hero_line_3}</span>
      </div>
      <p class="hero-turn">
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_turn_prefix">{home.hero_turn_prefix}</span><em data-editable="text" data-prop="@file[src/data/pages/home.json].hero_turn_accent">{home.hero_turn_accent}</em>
      </p>
      <div class="hero-divider" aria-hidden="true"></div>
      <p class="hero-sub">
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_lead">{home.hero_sub_lead}</span><strong data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_b1">{home.hero_sub_b1}</strong><span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_mid">{home.hero_sub_mid}</span><strong data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_b2">{home.hero_sub_b2}</strong><span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_after">{home.hero_sub_after}</span><span class="outcome" data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_outcome">{home.hero_sub_outcome}</span><span data-editable="text" data-prop="@file[src/data/pages/home.json].hero_sub_end">{home.hero_sub_end}</span>
      </p>
    </section>

    <section class="explore" id="assessments">
      <div class="eyebrow" data-editable="text" data-prop="@file[src/data/pages/home.json].section_eyebrow">{home.section_eyebrow}</div>
      <h2 class="split-heading">
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].section_heading_top">{home.section_heading_top}</span>
        <span class="accent" data-editable="text" data-prop="@file[src/data/pages/home.json].section_heading_accent">{home.section_heading_accent}</span>
      </h2>
      <div
        class="function-grid"
        data-editable="array"
        data-prop="@file[src/data/pages/home.json].cards"
        data-component="reflection-card"
        data-direction="row"
      >
        {home.cards.map((card) => (
          <article class="test-card" data-editable="array-item" data-component="reflection-card">
            <ReflectionCard {...card} />
          </article>
        ))}
      </div>
      <p class="footnote">
        <span data-editable="text" data-prop="@file[src/data/pages/home.json].footnote_prefix">{home.footnote_prefix}</span><a href="/book-session.html" data-editable="text" data-prop="@file[src/data/pages/home.json].footnote_link_label">{home.footnote_link_label}</a><span data-editable="text" data-prop="@file[src/data/pages/home.json].footnote_suffix">{home.footnote_suffix}</span>
      </p>
    </section>
  </main>
</BaseLayout>

