---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/book-session.json';
import { withBase } from '../utils/url';
---
<BaseLayout title={page.page_title} currentHref="/book-session.html" navMode="primary" loadBookingConfig={true}>
  <style slot="head">
    main {
      max-width: 780px;
      margin: 56px auto 80px;
      padding: 0 22px;
      text-align: center;
    }
    .panel {
      background: #fff;
      border: 1px solid #d7d3ca;
      border-top: 4px solid #b79a69;
      border-radius: 6px;
      padding: clamp(28px, 5vw, 48px);
    }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: .78rem;
      color: #806a4a;
      font-weight: 650;
    }
    h1 {
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      line-height: 1.15;
      margin: 10px 0 16px;
      color: #15243a;
    }
    main p { max-width: 600px; margin: 0 auto 16px; font-size: 1.06rem; }
    .button {
      display: inline-block;
      padding: 13px 24px;
      border: 1px solid #b79a69;
      background: #b79a69;
      color: #15243a;
      text-decoration: none;
      font-weight: 650;
      border-radius: 3px;
      margin-top: 10px;
    }
    .button.alt {
      background: transparent;
      border-color: #15243a;
      color: #15243a;
    }
    .note {
      margin: 24px auto 0;
      padding: 14px 18px;
      background: #eee9df;
      border-left: 3px solid #b79a69;
      text-align: left;
      font-size: .94rem;
      color: #283442;
      max-width: 580px;
    }
  </style>

  <main>
    <div class="panel">
      <div class="eyebrow">{page.eyebrow}</div>
      <h1>{page.heading}</h1>
      <p>{page.body}</p>
      <div id="live-booking" style="display:none">
        <a class="button" id="live-booking-link" href="#">{page.live_button_label}</a>
      </div>
      <div id="pending-booking" class="note">
        <strong>{page.pending_heading}</strong>{' '}
        <span>{page.pending_message}</span>
      </div>
      <div style="margin-top: 24px;">
        <a class="button alt" href={withBase('/index.html')}>{page.back_button_label}</a>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      const url = (window.CORE9_BOOKING_URL || '').trim();
      if (url) {
        const link = document.getElementById('live-booking-link');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        document.getElementById('live-booking').style.display = 'block';
        document.getElementById('pending-booking').style.display = 'none';
      }
    })();
  </script>
</BaseLayout>

