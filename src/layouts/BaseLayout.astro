---
import site from '../data/site.json';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  currentHref: string;
  navMode?: 'primary' | 'phase2';
  bodyBackground?: string;
  headerMaxWidth?: number;
  footerExtra?: string;
  loadBookingConfig?: boolean;
}

const {
  title = site.brand_name,
  currentHref,
  navMode = 'primary',
  bodyBackground = '#f7f6f3',
  headerMaxWidth = 960,
  footerExtra = '',
  loadBookingConfig = false,
} = Astro.props;

const navItems: NavLink[] = navMode === 'phase2' ? site.phase2_nav : site.primary_nav;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {!site.allow_search_indexing && <meta name="robots" content="noindex,nofollow">}
  <title>{title}</title>
  {loadBookingConfig && <script is:inline src="/assessments/booking-config.js"></script>}
  <style is:global>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: #172338;
      font-family: system-ui, -apple-system, Segoe UI, sans-serif;
      line-height: 1.6;
    }
    a { color: inherit; }
    header.site-header {
      background: #15243a;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }
    header.site-header strong { letter-spacing: .06em; }
    header.site-header nav { display: flex; gap: 20px; flex-wrap: wrap; }
    header.site-header nav a { color: #fff; font-size: .95rem; text-decoration: none; }
    header.site-header nav a[aria-current="page"] { color: #b79a69; font-weight: 650; }
    footer.site-footer {
      padding: 28px 22px;
      text-align: center;
      background: #101d2e;
      color: #ddd;
      font-size: .85rem;
    }
    footer.site-footer a { color: #fff; margin: 0 9px; }
    a:focus-visible, button:focus-visible { outline: 3px solid #d3a34c; outline-offset: 3px; }
    @media (max-width: 700px) {
      header.site-header { align-items: flex-start; }
      header.site-header nav { gap: 12px; }
    }
  </style>
  <slot name="head" />
</head>
<body style={`background: ${bodyBackground};`}>
  <header class="site-header" style={`padding: 18px max(22px, calc((100vw - ${headerMaxWidth}px) / 2));`}>
    <strong data-editable="text" data-prop="@file[src/data/site.json].brand_name">{site.brand_name}</strong>
    <nav aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.href === currentHref ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </header>

  <slot />

  <footer class="site-footer">
    <span>{site.brand_name}</span>
    {navItems.map((item) => (
      <>
        {' · '}
        <a href={item.href}>{item.label}</a>
      </>
    ))}
    {footerExtra && <p>{footerExtra}</p>}
  </footer>

  <script>
    if (window.inEditorMode) {
      import('../scripts/register-components.js').catch((err) => {
        console.warn('CloudCannon component registration failed:', err);
      });
    }
  </script>
</body>
</html>

